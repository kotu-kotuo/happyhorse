rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userID} {
      allow read;
      // good / bad are only counted by the reviewRating function (#31).
      allow create: if isUserAuthenticated(userID)
        && incomingData().id == userID
        && incomingData().get('good', 0) == 0
        && incomingData().get('bad', 0) == 0;
      allow update: if isUserAuthenticated(userID)
        && !dataDiff().affectedKeys().hasAny(['good', 'bad', 'id']);

      match /posts/{postID} {
        allow read;
        allow create: if isUserAuthenticated(userID) && incomingData().userID == userID;
        // The deal fields (clientUserID, isAvairable) gate reviews, so only the
        // owner sets them. Others get one narrow change each: toggle their own
        // like, record their own message, or (the client) finish the rating.
        allow update: if (isUserAuthenticated(userID) && incomingData().userID == userID)
          || (dataDiff().affectedKeys().hasOnly(['likeUserIDs'])
            && onlyChangedBy('likeUserIDs'))
          || (dataDiff().affectedKeys().hasOnly(['sendMessageUserIDs', 'messageUpdatedAt', 'latestMessage'])
            && request.auth.uid in incomingData().sendMessageUserIDs
            && onlyAddedBy('sendMessageUserIDs'))
          || (dataDiff().affectedKeys().hasOnly(['messageUpdatedAt', 'latestMessage', 'ratingCompleted'])
            && request.auth.uid == existingData().clientUserID);
        allow delete: if isUserAuthenticated(userID);

        match /chatrooms/{sendUserID} {
          allow read: if isAuthenticated();
          allow create: if isUserAuthenticated(sendUserID)
            && incomingData().sendUserID == sendUserID
            && incomingData().postUserID == userID
            && incomingData().messageCount == 1;
          allow update: if request.auth.uid in [userID, sendUserID]
            && !dataDiff().affectedKeys().hasAny(['sendUserID', 'postUserID']);
          allow delete: if isUserAuthenticated(existingData().postUserID);

          match /messages/{messageId} {
            allow read: if isAuthenticated();
            // The receiver gets a notification mail, so both ends must be the
            // two people of an existing chatroom (#32).
            allow create: if isAuthenticated()
              && isUserAuthenticated(incomingData().userID)
              && incomingData().postID == postID
              && request.auth.uid in [userID, sendUserID]
              && incomingData().messageReceiverID in [userID, sendUserID]
              && incomingData().messageReceiverID != request.auth.uid
              && exists(/databases/$(database)/documents/users/$(userID)/posts/$(postID)/chatrooms/$(sendUserID));
            // Only profile edits and withdrawal rewrite a sent message.
            allow update: if isUserAuthenticated(existingData().userID)
              && dataDiff().affectedKeys().hasOnly(['username', 'avatar', 'deletedAccount']);
            allow delete: if (isUserAuthenticated(existingData().userID) || isUserAuthenticated(existingData().messageReceiverID)) && existingData().postID == postID;
          }
        }
      }

      // A new review adds to the receiver's good / bad count (reviewRating), so
      // it may only be written by the two people of a closed deal, once per
      // post, about the other person (#31). The doc ID is the post ID.
      match /reviews/{reviewId} {
        allow read;
        allow create: if isAuthenticated()
          && incomingData().postID == reviewId
          && incomingData().receiverID == userID
          && incomingData().reviewerID != userID
          && incomingData().rating in ['good', 'bad']
          && isClosedDealOf(
            database,
            incomingData().postUserID,
            reviewId,
            [request.auth.uid, userID, incomingData().reviewerID]
          );
        // Profile edits and withdrawal rewrite the reviewer's name and avatar; the
        // review itself stays as it was counted.
        allow update: if isUserAuthenticated(existingData().reviewerID)
          && dataDiff().affectedKeys().hasOnly(['reviewerName', 'reviewerAvatar', 'deletedAccount']);
      }

      match /filters/{filterId} {
        allow read: if isUserAuthenticated(userID);
        allow create: if isUserAuthenticated(userID);
        allow update: if isUserAuthenticated(userID);
      }

      match /likePosts/{likePostId} {
        allow read: if isAuthenticated();
        allow create: if isUserAuthenticated(incomingData().likePostUserID);
        allow update: if isAuthenticated();
        allow delete: if isUserAuthenticated(existingData().userID) || isUserAuthenticated(existingData().likePostUserID);
      }

      match /drafts/{draftId} {
        allow read: if isUserAuthenticated(userID);
        allow create, update: if isUserAuthenticated(incomingData().userID);
        allow delete: if isUserAuthenticated(userID);
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated();
        allow create: if isUserAuthenticated(incomingData().sendUserID) || isUserAuthenticated(incomingData().receiveUserID);
        allow update: if isUserAuthenticated(userID);
        allow delete: if isUserAuthenticated(userID);
      }
    }

    match /reviewsOnHold/{reviewsOnHoldId} {
      allow read: if isAuthenticated();
      allow create: if isUserAuthenticated(incomingData().reviewerID);
      allow update: if isUserAuthenticated(incomingData().reviewerID);
      allow delete: if isUserAuthenticated(existingData().reviewerID) || isUserAuthenticated(existingData().postUserID);
    }

    match /{paths=**}/reviewsOnHold/{reviewsOnHoldId} {
      allow read: if isUserAuthenticated(existingData().reviewerID);
      allow update: if isUserAuthenticated(incomingData().reviewerID);
    }

    match /{paths=**}/posts/{postId} {
      allow read;
    }

    match /{paths=**}/chatrooms/{chatroomId} {
      allow read: if isAuthenticated() && (isUserAuthenticated(existingData().sendUserID) || isUserAuthenticated(existingData().postUserID));
    }

    match /{paths=**}/messages/{messageId} {
      allow read: if isUserAuthenticated(existingData().userID) || isUserAuthenticated(existingData().messageReceiverID);
    }

    match /{paths=**}/likePosts/{likePostId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /{paths=**}/reviews/{reviewId} {
      allow read;
    }
  }
}


   function documentPath(paths) {
      return path([
        ['databases', database, 'documents'].join('/'),
        paths.join('/')
      ].join('/'));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserAuthenticated(userID) {
      return request.auth.uid == userID;
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    function getData(path) {
      return get(path).data;
    }

    function getAfterData(path) {
      return getAfter(path).data;
    }

    function isRequestedTime(time) {
      return time == request.time;
    }

    function validateString(text, min, max) {
      return text is string
        && min <= text.size()
        && text.size() <= max;
    }

    function validateNumber(num, min, max) {
      return num is number
        && min <= num
        && num <= max;
    }

    // The deal has a client who really opened a chatroom on the post (only the
    // inquirer can create it), it is closed, and every uid is one of its two
    // people. Without the chatroom an owner could name anyone as the client.
    function isClosedDealOf(database, postUserID, postID, uids) {
      let post = get(/databases/$(database)/documents/users/$(postUserID)/posts/$(postID)).data;
      return post.clientUserID != ''
        && post.isAvairable == false
        && exists(/databases/$(database)/documents/users/$(postUserID)/posts/$(postID)/chatrooms/$(post.clientUserID))
        && uids.toSet().difference([post.userID, post.clientUserID].toSet()).size() == 0;
    }

    // The list field changed by exactly the caller's uid (added or removed).
    function onlyChangedBy(field) {
      let before = existingData().get(field, []).toSet();
      let after = incomingData().get(field, []).toSet();
      return after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }

    // The list field only gained the caller's uid; nobody else was removed.
    function onlyAddedBy(field) {
      let before = existingData().get(field, []).toSet();
      let after = incomingData().get(field, []).toSet();
      return after.hasAll(before) && after.difference(before).hasOnly([request.auth.uid]);
    }

    function dataDiff() {
      return incomingData().diff(existingData());
    }

    function isNotChanged(keys) {
      let affectedKeys = dataDiff().affectedKeys();
      return !affectedKeys.hasAny(keys.toSet());
    }
